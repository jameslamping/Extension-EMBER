<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Landis.Extension.EMBER</RootNamespace>
    <AssemblyName>Landis.Extension.EMBER-v1</AssemblyName>
    <AssemblyTitle>Landis.Extension.EMBER-v1</AssemblyTitle>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0</FileVersion>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Authors>James Lamping</Authors>
    <Product>Landis.Extension.EMBER-v1</Product>
    <Description>EMBER: Ecosystem-coupled Moisture, Behavior, Effects and Regimes. A mechanistic, climate-sensitive fire extension for LANDIS-II v8.</Description>
    <PackageTags>LANDIS-II;Landis;Extension;fire;fuel moisture;fire behavior;fire effects</PackageTags>
    <NeutralLanguage>English</NeutralLanguage>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Landis.Core" Version="3.0.1" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Landis.Library.UniversalCohorts-v2">
      <HintPath>lib\Landis.Library.UniversalCohorts-v2.dll</HintPath>
    </Reference>
    <Reference Include="Landis.Library.Climate-v6">
      <HintPath>lib\Landis.Library.Climate-v6.dll</HintPath>
    </Reference>
    <Reference Include="Landis.Library.Metadata-v2">
      <HintPath>lib\Landis.Library.Metadata-v2.dll</HintPath>
    </Reference>
    <Reference Include="Landis.Library.Parameters-v2">
      <HintPath>lib\Landis.Library.Parameters-v2.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
